{
  "name": "@deltix/sso-auth",
  "version": "2.3.1",
  "description": "",
  "typings": "dist/esm/sso-auth.d.ts",
  "main": "dist/es2015/sso-auth.js",
  "module": "dist/esm/sso-auth.js",
  "es2015": "dist/es2015/sso-auth.js",
  "exports": {
    ".": {
      "types": "./dist/esm/sso-auth.d.ts",
      "import": "./dist/esm/sso-auth.js",
      "require": "./dist/cjs/sso-auth.js"
    }
  },
  "scripts": {
    "build": "yarn build:es2015 && yarn build:esm && yarn build:cjs",
    "build:es2015": "tsc --project tsconfig.build.json --module es2015 --target es2015 --outDir dist/es2015",
    "build:esm": "tsc --project tsconfig.build.json --module esnext --target esnext --outDir dist/esm --declaration",
    "build:cjs": "tsc --project tsconfig.build.json --module commonjs --target es5 --outDir dist/cjs",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.deltixhub.com/Deltix/Common/Web/sso-auth.git"
  },
  "keywords": [
    "Authorization",
    "SSO",
    "OAuth",
    "JavaScript",
    "Silent-authentication"
  ],
  "author": "Deltix",
  "license": "ISC",
  "dependencies": {
    "@openid/appauth": "^1.3.1"
  },
  "devDependencies": {
    "@types/jest": "^29.4.0",
    "@types/node": "^18.11.19",
    "jest": "^29.4.1",
    "ts-jest": "^29.0.5",
    "typescript": "^4.9.5"
  }
}
